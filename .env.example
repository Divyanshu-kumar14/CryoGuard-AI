# Copy to .env and fill in only what you are using. .env is gitignored.
# `make demo` and `make serve` load .env automatically; the process environment
# wins over the file. Never commit .env and never paste a key into a chat.
#
# Live SAM 3.1 (Phase 3). Without this key, sam.mode must stay "off" or "cache".
META_API_KEY=
# Muse Spark Open report client (Phase 7). Without it, the deterministic report
# is used; the incident still completes (NFR-SAF-01).
MUSE_API_KEY=
# Optional bearer token for a real Redfish BMC. The loopback mock ignores it.
CRYOGUARD_BMC_TOKEN=
