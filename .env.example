# Copy to .env and fill in only what you are using. .env is gitignored.
# `make demo` and `make serve` load .env automatically; the process environment
# wins over the file. Never commit .env and never paste a key into a chat.
#
# Live SAM 3.1 (Phase 3). Without this key, sam.mode must stay "off" or "cache".
META_API_KEY=
#
# Baseten serves Muse Spark Open through an OpenAI-compatible endpoint.
# These two values are not secrets; they are the defaults from configs/default.yaml.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Muse Spark Open is a reasoning model: 600 tokens can be spent on reasoning
# before any JSON content is emitted. 2400 leaves room for the short answer.
BASETEN_MAX_TOKENS=2400
# Compatibility alias: BASETEN_API_KEY wins when both are set.
MUSE_API_KEY=
#
# Optional bearer token for a real Redfish BMC. The loopback mock ignores it.
# The client sends it as X-Auth-Token (a Redfish session token, not Basic auth).
CRYOGUARD_BMC_TOKEN=
